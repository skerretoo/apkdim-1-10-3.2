<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="notatnik.MainWindow"
        Title="Notatnik" Width="800" Height="450">
    <Grid ColumnDefinitions="*, 250" RowDefinitions="Auto, *, Auto" Margin="10">
        <!-- Lewa strona: edytor -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nowa notatka / edycja:" FontWeight="Bold" Margin="0,0,0,5"/>
        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8" Margin="0,0,10,0">
            <TextBox x:Name="TitleBox" PlaceholderText="Tytuł..." />
            <TextBox x:Name="ContentBox" PlaceholderText="Treść..." AcceptsReturn="True"
                     TextWrapping="Wrap" Height="280" VerticalContentAlignment="Top"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,10,10,0">
            <Button x:Name="SaveButton" Content="Zapisz" Width="100"/>
            <Button x:Name="NewButton" Content="Nowa" Width="100"/>
            <Button x:Name="DeleteButton" Content="Usuń" Width="100"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Prawa strona: lista -->
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Zapisane notatki:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ListBox Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" x:Name="NotesList"/>
    </Grid>
</Window>
